# Runtime compose defaults are safe local-development values. Replace every
# credential and origin before using a shared or production environment.
MONGO_REPLICA_SET_NAME=rs0
MONGO_PORT=27017
REDIS_PASSWORD=dev_redis_password
REDIS_PORT=6379
MINIO_ACCESS_KEY=dev_minio_access
MINIO_SECRET_KEY=dev_minio_secret
MINIO_BUCKET_PRIVATE=baza-private
MINIO_BUCKET_PUBLIC=baza-public
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Presigned upload URLs are opened by the host browser in the runtime E2E
# gate. Use http://host.docker.internal:${MINIO_PORT} for that mode; keep the
# internal http://minio:9000 default when clients run inside the compose network.
MINIO_ENDPOINT=http://minio:9000
# Public URLs returned for derivative media. For host-browser E2E runs use
# http://localhost:${MINIO_PORT}/baza-public so the browser can load images.
MINIO_PUBLIC_BASE_URL=http://minio:9000/baza-public
API_PORT=3000
ADMIN_WEB_PORT=4174
MARKETPLACE_WEB_PORT=4173
CORS_ALLOWED_ORIGIN_MARKETPLACE=http://localhost:4173
CORS_ALLOWED_ORIGIN_ADMIN=http://localhost:4174
# No erp-web app exists in this worktree (compose.runtime.yml's fourth app
# service is admin-web, not erp-web) - CORS_ALLOWED_ORIGIN_ERP is left unset
# here on purpose; set it only if you add a real ERP app service.
# Vite values are build-time values. Relative paths use the nginx API proxy.
VITE_PLATFORM_API_BASE_URL=/api/v1
VITE_CRM_API_BASE_URL=/api/v1
VITE_API_BASE_URL=/api/v1
# Required for the MapLibre catalogue and publisher map picker.
# Replace with an approved OSM-compatible style JSON URL before deployment.
VITE_MAP_STYLE_URL=REPLACE_ME_OSM_COMPATIBLE_STYLE_URL
