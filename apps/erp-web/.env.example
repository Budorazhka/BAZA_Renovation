# Пример env для фронтенда (скопируйте в .env.local при необходимости)

# --- Локальная разработка (значения как в .env.development) ---
VITE_CRM_API_BASE_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
# Новый BAZA Platform API (лиды, новостройки и другие новые модули).
VITE_PLATFORM_API_BASE_URL=http://localhost:3000
VITE_API_URL_MSGR=http://localhost:3001/api
VITE_SOCKET_URL_MSGR=http://localhost:3001

# Публичный API baza.sale (если не задан — в dev идёт на localhost:3000)
# VITE_USER_FAVORITES_API_BASE_URL=https://api.baza.sale

# --- Production (сборка npm run build) ---
# VITE_CRM_API_BASE_URL=https://api-crm.baza.sale
# Обязательная переменная: fallback на legacy CRM намеренно запрещён.
# VITE_PLATFORM_API_BASE_URL=https://api-new.example.com
# VITE_API_URL_MSGR=https://api-msngrs.baza.sale/api
# VITE_SOCKET_URL_MSGR=https://api-msngrs.baza.sale
# VITE_API_URL_MSGR=https://ai-erp.baza.sale/api
