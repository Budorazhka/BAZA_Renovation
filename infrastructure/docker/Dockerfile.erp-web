# Node 22, как у всех остальных образов (api, worker, admin-web, marketplace-web)
# и как в CI. Здесь стояло 20, и это молча работало ровно до 04.09.2026: до
# добавления erp-web в runtime-стек образ не собирался вообще нигде. Первая же
# сборка упала на `pnpm install` с ERR_UNKNOWN_BUILTIN_MODULE: node:sqlite —
# встроенный модуль, которого в Node 20 нет.
FROM node:22-bookworm-slim AS build

WORKDIR /workspace
ENV COREPACK_HOME=/tmp/corepack
ARG VITE_PLATFORM_API_BASE_URL=/api/v1
ARG VITE_CRM_API_BASE_URL=/api/v1
ENV VITE_PLATFORM_API_BASE_URL=${VITE_PLATFORM_API_BASE_URL}
ENV VITE_CRM_API_BASE_URL=${VITE_CRM_API_BASE_URL}

RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --filter=@baza/erp-web...

FROM nginx:1.27-alpine AS runtime

COPY infrastructure/docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/erp-web/dist /usr/share/nginx/html
EXPOSE 80
