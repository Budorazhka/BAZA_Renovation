FROM node:20-bookworm-slim AS build

WORKDIR /workspace
ENV COREPACK_HOME=/tmp/corepack
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --filter=@baza/marketplace-web...

FROM nginx:1.27-alpine AS runtime

COPY infrastructure/docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/marketplace-web/dist /usr/share/nginx/html
EXPOSE 80
